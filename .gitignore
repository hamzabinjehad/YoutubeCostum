apple/generated/
.DS_Store
*.xcuserstate
xcuserdata/
build/
.harness/

# Chrome's extension signing key. Whoever holds this can publish updates that
# look like they came from you — it must never leave the machine.
extension.pem
extension.crx

# Stray clones of this same repo that ended up inside it.
/YoutubeCostum/
/YoutubeCustomizer/

# Editor and agent tooling installed per machine. impeccable ships a 14MB
# platform binary into each of these; the install is `npx impeccable install`,
# not something to carry in the repo.
.agents/
.claude/
.codex/
.cursor/

# Chrome compiles the declarativeNetRequest rules here when it loads the
# unpacked extension. Build output, regenerated on every load.
extension/_metadata/

# package.sh moves the previous Xcode project aside instead of deleting it
apple/generated.bak-*/
